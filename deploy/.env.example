# Copy to <DEPLOY_DIR>/.env on the server and set real values. Never commit the real file.
# PostgreSQL container on the postgresql network; the database and user must exist already.
POSTGRES_HOST=postgres
POSTGRES_DB=workout
POSTGRES_USER=workout
POSTGRES_PASSWORD=change-me
# RustFS S3 API on the rustfs network; the keys are the RUSTFS_ACCESS_KEY/RUSTFS_SECRET_KEY RustFS was started with
STORAGE_S3_ENDPOINT=http://rustfs:9000
STORAGE_S3_BUCKET=workout
STORAGE_S3_ACCESS_KEY=change-me
STORAGE_S3_SECRET_KEY=change-me
